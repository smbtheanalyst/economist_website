# ==============================================================================
# Environment Configuration - Economist Website
# ==============================================================================

# Application Environment
NODE_ENV=development
PORT=3000
SITE_URL=http://localhost:3000

# SQLite Database File Path (will be created automatically if missing)
DATABASE_PATH=./data/economist.db

# Admin Session Secret (Random string, min 32 chars in production)
ADMIN_SESSION_SECRET=local-development-secret-change-in-production-min-32-chars

# File Upload Directory (persisted local folder or mounted volume)
UPLOAD_DIR=./public/uploads

# Booking Configuration
# Timezone strictly Africa/Dar_es_Salaam (EAT, UTC+3)
SITE_TIMEZONE=Africa/Dar_es_Salaam
# Pending reservation auto-expiry in hours (releases slot if unconfirmed)
PENDING_BOOKING_EXPIRY_HOURS=24

# Outgoing Email / SMTP Service
# In local development, if SMTP credentials are blank, all emails (verification,
# receipts, booking notifications) are safely captured to the local database outbox
# and previewable immediately in the Admin Dashboard at /admin/emails.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Dr. Researcher <noreply@example.com>"
