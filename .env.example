# ==============================================================================
# Environment Configuration - TEFPC & Dr. Hamis Miraji Ally Simba Platform
# ==============================================================================

# Application Environment
# In Railway: Set to 'production'. On local machine: 'development'.
NODE_ENV=production
# Listening Port: On Railway, $PORT is injected automatically by the platform.
PORT=3000

# Public and Admin Domain Routing (Host-Aware Middleware)
SITE_URL=https://tefpc.or.tz
ADMIN_ORIGIN=https://admin.tefpc.or.tz
ADMIN_HOST=admin.tefpc.or.tz

# Persistent Storage Beneath Railway Volume (/data)
# On Railway, mount a persistent volume at path '/data'.
# Local development defaults: ./data/economist.db and ./data/uploads.
DATABASE_PATH=/data/economist.db
UPLOAD_DIR=/data/uploads

# Admin Session Secret (Generate a random 64-char string for production)
ADMIN_SESSION_SECRET=generate-random-64-character-string-for-production-security

# Booking Policies
SITE_TIMEZONE=Africa/Dar_es_Salaam
PENDING_BOOKING_EXPIRY_HOURS=24

# Outgoing SMTP Configuration
# CRITICAL NOTICE:
# In production (NODE_ENV=production), if SMTP is not configured, the system
# EXPLICITLY REFUSES to silently capture emails locally and logs a delivery failure.
# Populate these with client production SMTP credentials prior to live launch.
# NOTE: Do NOT use info@tefpc.or.tz until the client officially activates that mailbox.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="TEFPC Notifications <noreply@tefpc.or.tz>"

# Optional: Initial Non-Interactive Admin Bootstrap (Used during deployment)
# If set, running 'npm run admin:bootstrap' non-interactively creates/updates this account.
ADMIN_BOOTSTRAP_USER=
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=
